# Vercel Serverless Function -> Resend (see api/contact.mjs)
#
# These variables are read from process.env by the Vercel function.
# In production they are configured in the Vercel dashboard under
# Project Settings -> Environment Variables. Copy this file to .env.local
# only if you run the function locally (e.g. `vercel dev`).

# REQUIRED to actually deliver email: a Resend API key
# (https://resend.com/api-keys). Without it the API returns an error
# and the form shows the generic failure message.
RESEND_API_KEY=

# Where submissions are delivered (default: smsiam987@gmail.com)
EMAIL_TO=

# Verified sender shown to recipients (default: Siam.Dev Contact <onboarding@resend.dev>)
# If changed, the domain must be verified in the Resend dashboard.
EMAIL_FROM=

# Canonical site URL used inside the email (default: https://siam-portfolio-theta.vercel.app)
SITE_URL=

# Max submissions per IP per minute (default: 5)
RATE_LIMIT_MAX=